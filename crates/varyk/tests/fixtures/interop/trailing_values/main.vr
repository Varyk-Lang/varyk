mod ext;

struct User {
    name: string,
    age: i64,
    nick: Option<string>,
}

fn main() {
    let zero = ext::run("q");
    let one = ext::run("q", 1);
    let three = ext::run("q", true, "Ada", 1.5);
    let b = true;
    let text = "text";
    let x: f32 = 1.5;
    let y: f64 = 2.5;
    let i1: i8 = 1;
    let i2: i16 = 2;
    let i3: i32 = 3;
    let i4: i64 = 4;
    let u1: u8 = 5;
    let u2: u16 = 6;
    let u3: u32 = 7;
    let scalars = ext::run("q", b, text, x, y, i1, i2, i3, i4, u1, u2, u3);
    let ob: Option<bool> = Some(true);
    let os: Option<string> = Some("a");
    let ox: Option<f32> = None;
    let oy: Option<f64> = Some(1.0);
    let o1: Option<i8> = Some(1);
    let o2: Option<i16> = None;
    let o3: Option<i32> = Some(3);
    let o4: Option<i64> = None;
    let p1: Option<u8> = Some(1);
    let p2: Option<u16> = None;
    let p3: Option<u32> = Some(3);
    let options = ext::run("q", ob, os, ox, oy, o1, o2, o3, o4, p1, p2, p3);
    let user = User { name: "Ada", age: 36, nick: None };
    let names = vec!["Bo"];
    let places = ext::run("q", user.age, user.name, user.nick, names[0]);
    println!("{} {} {}", user.name, names[0], text);
    let db = ext::Db::new();
    let method = db.exec(1, user.age, "a");
    let associated = ext::Db::bind(1, 2, 3);
    let wrapped = ext::run("q", Some("Ada"), Some(text), Some(i4));
    println!("{} {} {} {} {} {} {} {} {}", zero, one, three, scalars, options, places, method, associated, wrapped);
}
