struct Task {
    title: string,
    done: bool,
}

struct Board {
    tasks: Vec<Task>,
}

impl Board {
    fn open_count(self) -> i32 {
        let mut count = 0;
        for t in self.tasks {
            if !t.done {
                count = count + 1;
            }
        }
        count
    }
}

fn make_tasks() -> Vec<Task> {
    vec![Task { title: "write", done: false }, Task { title: "test", done: true }]
}

fn titles(tasks: Vec<Task>) {
    for t in tasks {
        println!("{}", t.title);
    }
}

fn finish_all(mut tasks: Vec<Task>) -> i32 {
    let mut open = 0;
    for t in tasks {
        if t.done {
            continue;
        }
        open = open + 1;
    }
    for i in 0..tasks.len() {
        tasks[i].done = true;
    }
    open
}

fn sum(values: Vec<i32>) -> i32 {
    let mut total = 0;
    for value in values {
        total = total + value;
    }
    total
}

fn words() -> Vec<string> {
    vec!["alpha", "beta"]
}

fn shout(word: string) {
    println!("{}!", word);
}

fn main() {
    let numbers = vec![3, 4, 5];
    let mut total = 0;
    for n in numbers {
        if n == 5 {
            break;
        }
        total = total + n;
    }
    println!("{} {}", total, sum(numbers));
    for i in 0..3 {
        println!("{}", i);
    }
    let mut tasks = make_tasks();
    titles(tasks);
    println!("{} open, then {}", finish_all(tasks), finish_all(tasks));
    let board = Board { tasks: make_tasks() };
    println!("{}", board.open_count());
    let names = words();
    for name in names {
        shout(name);
    }
    for word in words() {
        shout(word);
    }
    let mut kept: Vec<Task> = Vec::new();
    for t in make_tasks() {
        kept.push(t);
    }
    println!("{}", kept.len());
}
