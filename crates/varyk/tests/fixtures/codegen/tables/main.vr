fn doubled(text: string) -> Result<i32, Error> {
    let n: i32 = text.parse()?;
    Ok(n * 2)
}

fn flag(text: string) -> Result<bool, Error> {
    text.parse()
}

fn show(n: Result<u8, Error>) {
    if let Ok(k) = n {
        println!("{}", k);
    }
}

fn main() {
    let mut counts: HashMap<string, i32> = HashMap::new();
    for word in vec!["apple", "pear", "apple"] {
        let before = counts.insert(word.clone(), 1);
        if let Some(n) = before {
            counts.insert(word, n + 1);
        }
    }
    println!("{} {}", counts.len(), counts.contains_key("apple"));

    let a: Result<f64, Error> = "1.5".parse();
    println!("{}", a.is_ok());
    show("7".parse());
    println!("{}", doubled("21").is_ok());
    println!("{}", flag("maybe").is_ok());

    let names = vec!["ann", "bob"];
    let e = "eve";
    println!("{}", names.contains(e));

    let mut numbers = vec![3, 1, 2];
    numbers.sort();
    numbers.insert(0, 9);
    let first = numbers.remove(0);
    println!("{} {} {}", first, numbers.contains(2), numbers.is_empty());

    let mut text = "hello";
    text.push_str(", world");
    let loud = text.to_uppercase();
    println!("{} {}", loud.replace("WORLD", "YOU"), text.starts_with("he"));
    let mut words = vec!["b", "a"];
    words.sort();
    println!("{}", words.join("+"));
    let r: Result<i32, string> = Err("no");
    println!("{} {}", r.is_ok(), r.is_err());
}
