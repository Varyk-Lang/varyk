mod ext;

struct Session {
    name: string,
    handle: ext::Handle,
}

struct Server {
    socket: ext::Socket,
}

fn main() {
    let session = Session { name: "main", handle: ext::open() };
    let copy = session.clone();
    println!("{}", copy.name);
    let server = Server { socket: ext::listen() };
    println!("{}", server.socket.port);
}
