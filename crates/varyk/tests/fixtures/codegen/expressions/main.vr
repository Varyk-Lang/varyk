fn double(x: i32) -> Result<i32, string> {
    let n: i32 = Ok(x)?;
    let m = Ok(n * 2)?;
    Ok(m)
}

fn lookup(x: i32) -> Option<i32> {
    let n: i32 = Some(x)?;
    Some(n)
}

fn first(x: i32) -> Option<i32> {
    let found = lookup(x);
    let n = found?;
    Some(n + 1)
}

fn main() {
    let a = 300;
    let big: i64 = 5000000000;
    let small = a as u8;
    let negative = -1 as u8;
    let braced = { 300 } as u8;
    let doubled = - -1 as u8;
    let negated = -{ 1 } as u8;
    let count = a as i64 < big;
    let scaled = a as i32 * 2;
    let total = (a + 1) as i64;
    let mut sum = 0;
    for i in 1..=3 {
        sum = sum + i;
    }
    println!("{} {} {} {} {} {}", big, small, negative, count, scaled, total);
    println!("{} {} {}", braced, doubled, negated);
    println!("{}", sum);
    match first(1) {
        Some(n) => println!("{}", n),
        None => println!("none"),
    }
}
