#![allow(dead_code, unused_variables, unused_mut, arithmetic_overflow, unconditional_panic)]

struct Label {
    text: String,
}

fn tail() -> String {
    "tail".to_string()
}

fn early(flag: bool) -> String {
    if flag {
        return "early".to_string();
    }
    "late".to_string()
}

fn relabel(label: &mut Label) {
    label.text = "b".to_string();
}

fn main() {
    let mut label = Label { text: "a".to_string() };
    relabel(&mut label);
    label.text = "c".to_string();
    println!("{} {} {}", label.text, tail(), early(true));
}
