#[allow(warnings, arithmetic_overflow, unconditional_panic)]
#[derive(Clone, PartialEq)]
struct Label {
    text: String,
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn tail() -> String {
    "tail".to_string()
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn early(flag: bool) -> String {
    if flag {
        return "early".to_string();
    }
    "late".to_string()
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn relabel(label: &mut Label) {
    label.text = "b".to_string();
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn main() {
    let mut label = Label { text: "a".to_string() };
    relabel(&mut label);
    label.text = "c".to_string();
    ::std::println!("{} {} {}", label.text, tail(), early(true));
}
