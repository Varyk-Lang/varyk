#[allow(warnings, arithmetic_overflow, unconditional_panic)]
struct User {
    name: String,
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn name_of(user: &User) -> String {
    user.name.clone()
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn main() {
    let user = User { name: "Alice".to_string() };
    let name = name_of(&user);
    ::std::println!("{}", name);
    let copy = name.clone();
    ::std::println!("{}", copy);
    ::std::println!("{}", ::std::format!("Hello, {}!", name));
    ::std::println!("{}", name.len());
    ::std::println!("{}", name == "Alice");
}
