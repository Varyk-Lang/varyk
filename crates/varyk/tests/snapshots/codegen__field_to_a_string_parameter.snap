struct User {
    name: String,
}

fn show(s: &str) {
    println!("{}", s);
}

fn show_user(user: &User) {
    show(&user.name);
}

fn main() {
    let user = User { name: "Ann".to_string() };
    show(&user.name);
    show_user(&user);
