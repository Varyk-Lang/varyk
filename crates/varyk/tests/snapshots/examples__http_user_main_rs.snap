async fn varyk_route_0(varyk_req: ::http::Request, varyk_res: ::http::Response) -> ::http::Response {
    let mut varyk_res = varyk_res;
    let varyk_2 = match varyk_req.state::<State>() {
        Ok(v) => v,
        Err(r) => return r,
    };
