mod task;

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn count_done(tasks: &Vec<crate::task::Task>) -> usize {
    tasks.iter().filter(|t| {
        let t = *t;
        crate::task::Task::is_done(t)
    }).count()
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn print_all(tasks: &Vec<crate::task::Task>) {
    for t in tasks {
        ::std::println!("{}", crate::task::Task::label(t));
    }
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn main() {
    let mut tasks: Vec<crate::task::Task> = Vec::new();
    tasks.push(crate::task::Task::new("Buy milk"));
    tasks.push(crate::task::Task::new("Write spec"));
    print_all(&tasks);
    crate::task::Task::complete(&mut tasks[0usize]);
    print_all(&tasks);
    ::std::println!("{} of {} done", count_done(&tasks), tasks.len());
}
