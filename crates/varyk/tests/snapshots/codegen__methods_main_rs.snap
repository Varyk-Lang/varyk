#![allow(dead_code, unused_variables, unused_mut, arithmetic_overflow, unconditional_panic)]

mod tally;

struct Task {
    label: String,
    done: bool,
}

enum Size {
    Small,
    Large,
}

impl Task {
    fn new(label: &str) -> Task {
        Task { label: label.to_string(), done: false }
    }

    fn complete(&mut self) {
        self.done = true;
    }

    fn label(&self) -> String {
        self.label.clone()
    }

    fn is_done(&self) -> bool {
        self.done
    }
}

impl Size {
    fn sides(&self) -> usize {
        4usize
    }
}

fn count_done(tasks: &Vec<Task>) -> usize {
    let mut n = 0usize;
    let mut i = 0usize;
    while i < tasks.len() {
        if tasks[i].is_done() {
            n = n + 1usize;
        }
        i = i + 1usize;
    }
    n
}

fn finish_first(tasks: &mut Vec<Task>) {
    tasks[0usize].complete();
}

fn main() {
    let mut tasks: Vec<Task> = Vec::new();
    tasks.push(Task::new("write"));
    tasks.push(Task::new("test"));
    finish_first(&mut tasks);
    tasks[1usize].complete();
    let first = &tasks[0usize];
    println!("{} done: {}", first.label(), first.is_done());
    println!("{} of {}", count_done(&tasks), tasks.len());
    let mut words: Vec<String> = vec!["a".to_string(), "b".to_string()];
    words[1usize] = "c".to_string();
    let word = &words[1usize];
    let copy = word.clone();
    let lit = "lit";
    let lit_copy = lit.to_string();
    println!("{} {} {} {}", word, copy, lit_copy, lit.len());
    let last: Option<String> = words.pop();
    let mut counts: Vec<i32> = vec![1, 2];
    counts[0usize] = counts[1usize] + 1;
    let size = Size::Large;
    println!("{} {}", counts[0usize], size.sides());
    let mut t = crate::tally::Tally::new();
    t.add(2);
    println!("{}", t.value());
}
