#![allow(dead_code, unused_variables, unused_mut, arithmetic_overflow, unconditional_panic)]

struct User {
    name: String,
    age: i32,
}

fn digit(text: &str) -> Result<i32, String> {
    if text == "one" {
        return Ok(1);
    }
    if text == "two" {
        return Ok(2);
    }
    Err(format!("`{}` is not a digit", text))
}

fn name_of(id: i32) -> Result<String, String> {
    if id == 1 {
        return Ok("Ada".to_string());
    }
    Err("no such user".to_string())
}

fn load(id: i32) -> Result<User, String> {
    let name = name_of(id)?;
    Ok(User { name: name, age: 36 })
}

fn check(text: &str) -> Result<bool, String> {
    digit(text)?;
    Ok(true)
}

fn sum(words: &Vec<String>) -> Result<i32, String> {
    let mut total = 0;
    for word in words {
        total = total + digit(word)?;
    }
    Ok(total)
}

fn first_age(id: i32) -> Result<i32, String> {
    let found: Result<User, String> = load(id);
    let user = found?;
    Ok(user.age + load(id)?.age)
}

fn describe(id: i32) -> Result<String, String> {
    let label = match name_of(id) {
        Ok(name) => name,
        Err(e) => name_of(1)?,
    };
    Ok(format!("{} ({})", label, load(1)?.name))
}

fn show(result: &Result<i32, String>) {
    match result {
        Ok(n) => {
            let n = *n;
            println!("ok {}", n)
        }
        Err(e) => println!("error: {}", e),
    }
}

fn main() {
    show(&sum(&vec!["one".to_string(), "two".to_string()]));
    show(&sum(&vec!["one".to_string(), "three".to_string()]));
    show(&first_age(1));
    show(&first_age(2));
    match check("two") {
        Ok(_) => println!("checked"),
        Err(e) => println!("error: {}", e),
    }
    match describe(5) {
        Ok(text) => println!("{}", text),
        Err(e) => println!("error: {}", e),
    }
}
