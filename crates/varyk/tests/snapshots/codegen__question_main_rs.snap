#[allow(warnings, arithmetic_overflow, unconditional_panic)]
#[derive(Clone, PartialEq)]
struct User {
    name: String,
    age: i32,
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn digit(text: &str) -> Result<i32, String> {
    if text == "one" {
        return Ok(1);
    }
    if text == "two" {
        return Ok(2);
    }
    Err(::std::format!("`{}` is not a digit", text))
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn name_of(id: i32) -> Result<String, String> {
    if id == 1 {
        return Ok("Ada".to_string());
    }
    Err("no such user".to_string())
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn load(id: i32) -> Result<User, String> {
    let name = name_of(id)?;
    Ok(User { name: name, age: 36 })
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn check(text: &str) -> Result<bool, String> {
    digit(text)?;
    Ok(true)
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn sum(words: &Vec<String>) -> Result<i32, String> {
    let mut total = 0;
    for word in words {
        total = total + digit(word)?;
    }
    Ok(total)
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn first_age(id: i32) -> Result<i32, String> {
    let found: Result<User, String> = load(id);
    let user = found?;
    Ok(user.age + load(id)?.age)
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn describe(id: i32) -> Result<String, String> {
    let label = match name_of(id) {
        Ok(name) => name,
        Err(e) => name_of(1)?,
    };
    Ok(::std::format!("{} ({})", label, load(1)?.name))
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn show(result: &Result<i32, String>) {
    match result {
        Ok(n) => {
            let n = *n;
            ::std::println!("ok {}", n)
        }
        Err(e) => ::std::println!("error: {}", e),
    }
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn main() {
    show(&sum(&::std::vec!["one".to_string(), "two".to_string()]));
    show(&sum(&::std::vec!["one".to_string(), "three".to_string()]));
    show(&first_age(1));
    show(&first_age(2));
    match check("two") {
        Ok(_) => ::std::println!("checked"),
        Err(e) => ::std::println!("error: {}", e),
    }
    match describe(5) {
        Ok(text) => ::std::println!("{}", text),
        Err(e) => ::std::println!("error: {}", e),
    }
}
