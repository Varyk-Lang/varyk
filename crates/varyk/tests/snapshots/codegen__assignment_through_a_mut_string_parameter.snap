#![allow(dead_code, unused_variables, unused_mut, arithmetic_overflow, unconditional_panic)]

fn set(name: &mut String) {
    *name = "x".to_string();
}

fn forward(name: &mut String) {
    set(name);
    println!("{}", name);
}

fn main() {
    let mut name = "a".to_string();
