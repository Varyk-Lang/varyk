#![allow(dead_code, unused_variables, unused_mut, arithmetic_overflow, unconditional_panic)]

fn make() -> String {
    "m".to_string()
}

fn show(s: &str) {
    println!("{}", s);
}

fn clear(s: &mut String) {
    *s = "".to_string();
}

fn f(c: bool, name: &str) -> bool {
    show(&(if c {
        make()
    } else {
        "lit".to_string()
    }));
    clear(&mut (if c {
        make()
    } else {
        make()
    }));
    println!("{}", if c {
        make()
    } else {
        "y".to_string()
    });
    (if c {
        make()
    } else {
        "y".to_string()
    }).as_str() == name
}

fn main() {
    println!("{}", f(true, "m"));
}
