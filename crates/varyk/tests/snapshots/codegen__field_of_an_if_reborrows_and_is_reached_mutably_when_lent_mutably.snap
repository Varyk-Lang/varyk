#[allow(warnings, arithmetic_overflow, unconditional_panic)]
struct User {
    name: String,
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn clear(s: &mut String) {
    *s = "".to_string();
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn show(user: &User) {
    ::std::println!("{}", user.name);
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn f(c: bool, user: &mut User) {
    let mut other = User { name: "Bob".to_string() };
    ::std::println!("{}", (if c {
        &other
    } else {
        &*user
    }).name);
    clear(&mut (if c {
        &mut other
    } else {
        &mut *user
    }).name);
    show(user);
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn main() {
    f(true, &mut User { name: "Ann".to_string() });
}
