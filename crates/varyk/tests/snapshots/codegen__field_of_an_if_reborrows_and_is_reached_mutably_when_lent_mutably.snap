#![allow(dead_code, unused_variables, unused_mut, arithmetic_overflow, unconditional_panic)]

struct User {
    name: String,
}

fn clear(s: &mut String) {
    *s = "".to_string();
}

fn show(user: &User) {
    println!("{}", user.name);
}

fn f(c: bool, user: &mut User) {
    let mut other = User { name: "Bob".to_string() };
    println!("{}", (if c {
        &other
    } else {
        &*user
    }).name);
    clear(&mut (if c {
        &mut other
    } else {
        &mut *user
    }).name);
    show(user);
}

fn main() {
    f(true, &mut User { name: "Ann".to_string() });
}
