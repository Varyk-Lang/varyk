mod geo;

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
enum Shape {
    Circle(f64),
    Rect(f64, f64),
    Named(String, Option<String>),
    Point,
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
struct Inbox {
    items: Vec<String>,
    last: Option<Shape>,
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn area(known: bool) -> Result<f64, String> {
    if known {
        return Ok(2.5);
    }
    Err("no area".to_string())
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn counts(n: usize) -> Vec<usize> {
    ::std::vec![n, 1usize, 2usize]
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn main() {
    let name = "box".to_string();
    let label = ::std::format!("{} has {} sides", name, 4);
    ::std::println!("{}", label);
    let shapes: Vec<Shape> = ::std::vec![Shape::Circle(1.0), Shape::Rect(2.0, 3.0), Shape::Point];
    let named = Shape::Named(label, None);
    let far = crate::geo::Shape::Point;
    let near = crate::geo::Shape::Circle(0.5);
    let user = crate::geo::User { name: "Ann".to_string() };
    let empty: Vec<i32> = ::std::vec![];
    let maybe: Option<i32> = None;
    let inbox = Inbox { items: ::std::vec!["a".to_string(), name], last: Some(named) };
    let result: Result<f64, String> = area(false);
    let sizes: Vec<usize> = counts(3usize);
    ::std::println!("{}", ::std::format!("{}!", user.name));
}
