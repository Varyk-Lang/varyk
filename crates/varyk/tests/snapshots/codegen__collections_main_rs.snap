#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn sum(values: &Vec<i32>) -> i32 {
    let mut total = 0;
    for value in values {
        let value = *value;
        total = total + value;
    }
    total
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn main() {
    let mut values: Vec<i32> = Vec::new();
    values.push(10);
    values.push(20);
    values.push(30);
    ::std::println!("{}", values.len());
    for i in 0usize..values.len() {
        ::std::println!("{}", values[i]);
    }
    ::std::println!("{}", sum(&values));
    values.pop();
    ::std::println!("{}", values.len());
}
