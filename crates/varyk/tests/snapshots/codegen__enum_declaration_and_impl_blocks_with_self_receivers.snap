#![allow(dead_code, unused_variables, unused_mut, arithmetic_overflow, unconditional_panic)]

enum Shape {
    Circle(f64),
    Named(String, Option<String>),
    Point,
}

struct Counter {
    count: i32,
}

impl Counter {
    fn new() -> Counter {
        Counter { count: 0 }
    }

    fn add(&mut self, by: i32) {
        self.count = self.count + by;
    }

    pub fn value(&self) -> i32 {
        self.count
    }
}

impl Shape {
    fn sides(&self) -> usize {
        0usize
    }
}

fn tally(v: &Vec<usize>, r: &Result<Shape, String>, c: &mut Counter) -> Option<Vec<String>> {
    c.count = 1;
    tally(v, r, c)
}

fn main() {
    let mut counter = Counter { count: 1 };
    counter.count = 2;
    println!("{}", counter.count);
}
