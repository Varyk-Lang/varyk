#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn show(s: &str) {
    ::std::println!("{}", s);
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn clear(s: &mut String) {
    *s = "".to_string();
}

