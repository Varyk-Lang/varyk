#[allow(warnings, arithmetic_overflow, unconditional_panic)]
#[derive(Clone, PartialEq)]
struct User {
    name: String,
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn clear(s: &mut String) {
    *s = "".to_string();
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn main() {
    let c = false;
    let mut user = User { name: "Ann".to_string() };
    let mut n = if c {
        &mut "x".to_string()
    } else {
        &mut user.name
    };
    clear(n);
    *n = "Bob".to_string();
    ::std::println!("{}", user.name);
}
