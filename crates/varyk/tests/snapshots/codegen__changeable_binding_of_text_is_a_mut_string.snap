#![allow(dead_code, unused_variables, unused_mut, arithmetic_overflow, unconditional_panic)]

struct User {
    name: String,
}

fn clear(s: &mut String) {
    *s = "".to_string();
}

fn main() {
    let c = false;
    let mut user = User { name: "Ann".to_string() };
    let mut n = if c {
        &mut "x".to_string()
    } else {
        &mut user.name
    };
    clear(n);
    *n = "Bob".to_string();
    println!("{}", user.name);
}
