#[allow(warnings, arithmetic_overflow, unconditional_panic)]
#[derive(Clone, PartialEq)]
pub enum Status {
    Open,
    Done,
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
#[derive(Clone, PartialEq)]
pub struct Item {
    title: String,
    status: Status,
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
impl Item {
    pub fn new(title: &str) -> Item {
        Item { title: title.to_string(), status: Status::Open }
    }

    pub fn complete(&mut self) {
        self.status = Status::Done;
    }

    pub fn is_done(&self) -> bool {
        match &self.status {
            Status::Done => true,
            Status::Open => false,
        }
    }

    pub fn title(&self) -> &str {
        &self.title
    }

    pub fn label(&self) -> String {
        let mark = if Item::is_done(self) {
            "x"
        } else {
            " "
        };
        ::std::format!("[{}] {}", mark, Item::title(self))
    }
}
