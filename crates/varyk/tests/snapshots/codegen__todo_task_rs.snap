#[allow(warnings, arithmetic_overflow, unconditional_panic)]
pub enum Status {
    Open,
    Done,
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
pub struct Task {
    title: String,
    status: Status,
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
impl Task {
    pub fn new(title: &str) -> Task {
        Task { title: title.to_string(), status: Status::Open }
    }

    pub fn complete(&mut self) {
        self.status = Status::Done;
    }

    pub fn is_done(&self) -> bool {
        match &self.status {
            Status::Done => true,
            Status::Open => false,
        }
    }

    pub fn label(&self) -> String {
        let mark = if Task::is_done(self) {
            "x"
        } else {
            " "
        };
        ::std::format!("[{}] {}", mark, self.title)
    }
}
