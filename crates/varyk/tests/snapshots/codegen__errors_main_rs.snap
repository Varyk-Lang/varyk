#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn parse_answer(text: &str) -> Result<i32, String> {
    if text == "42" {
        Ok(42)
    } else {
        Err(::std::format!("not a number: {}", text))
    }
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn doubled(text: &str) -> Result<i32, String> {
    let value = parse_answer(text)?;
    Ok(value * 2)
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn describe(result: &Result<i32, String>) -> String {
    match result {
        Ok(value) => {
            let value = *value;
            ::std::format!("{}", value)
        }
        Err(message) => message.clone(),
    }
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn first_even(values: &Vec<i32>) -> Option<i32> {
    for value in values {
        let value = *value;
        if value % 2 == 0 {
            return Some(value);
        }
    }
    None
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn main() {
    ::std::println!("{}", describe(&doubled("42")));
    ::std::println!("{}", describe(&doubled("abc")));
    match first_even(&::std::vec![1, 3, 5]) {
        Some(value) => ::std::println!("{}", value),
        None => ::std::println!("none"),
    }
}
