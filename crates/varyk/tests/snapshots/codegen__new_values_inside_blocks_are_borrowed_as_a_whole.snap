#[allow(warnings, arithmetic_overflow, unconditional_panic)]
#[derive(Clone, PartialEq)]
struct User {
    name: String,
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn make() -> User {
    User { name: "Ann".to_string() }
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn text() -> String {
    "t".to_string()
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn show(s: &str) {
    ::std::println!("{}", s);
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn show_user(user: &User) {
    ::std::println!("{}", user.name);
}

#[allow(warnings, arithmetic_overflow, unconditional_panic)]
fn main() {
    let c = true;
    let s = text();
    show(&(if c {
        text()
    } else {
        make().name
    }));
    show(&({
        let a = make();
        a.name
    }));
    show(&({
        let t = s;
        t
    }));
    show_user(&({
        let u = make();
        u
    }));
    ::std::println!("{}", if c {
        make().name
    } else {
        "lit".to_string()
    });
}
